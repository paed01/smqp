{
  "name": "smqp",
  "version": "12.0.1",
  "type": "module",
  "description": "Synchronous message queueing package",
  "author": {
    "name": "Pål Edman",
    "url": "https://github.com/paed01"
  },
  "module": "./src/index.js",
  "main": "./dist/index.cjs",
  "browser": "./dist/smqp.cjs",
  "jsnext:main": "./src/index.js",
  "sideEffects": false,
  "types": "./types/index.d.ts",
  "exports": {
    "types": "./types/index.d.ts",
    "import": "./src/index.js",
    "require": "./dist/index.cjs",
    "browser": "./dist/smqp.cjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/paed01/smqp.git"
  },
  "bugs": {
    "url": "https://github.com/paed01/smqp/issues"
  },
  "files": [
    "dist",
    "src",
    "types/index.d.ts",
    "types/index.d.ts.map"
  ],
  "engines": {
    "node": ">=18"
  },
  "c8": {
    "include": [
      "src"
    ]
  },
  "scripts": {
    "test": "mocha",
    "test:lcov": "c8 -r lcov mocha --exit",
    "posttest": "npm run dist && npm run lint && npm run toc && npm run test:md",
    "test:md": "texample ./README.md,API.md",
    "cov:html": "c8 -r html -r text mocha",
    "dist": "rollup -c && node ./scripts/build-types.js && npm run toc",
    "types": "node ./scripts/build-types.js",
    "prepublishOnly": "npm run dist",
    "toc": "node ./scripts/toc.js API.md",
    "lint": "eslint . --cache && prettier . -c --cache"
  },
  "keywords": [
    "messaging",
    "broker",
    "routing",
    "exchange",
    "queue",
    "fifo",
    "shovel",
    "publish",
    "subscribe",
    "ack",
    "nack",
    "reject",
    "topic",
    "direct",
    "independent"
  ],
  "overrides": {
    "c8": {
      "yargs": "^18.0.0"
    },
    "mocha": {
      "yargs": "^18.0.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.2",
    "c8": "^11.0.0",
    "chai": "^6.2.0",
    "chronokinesis": "^8.0.0",
    "dts-buddy": "^0.7.0",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "mocha": "^11.0.1",
    "prettier": "^3.2.5",
    "rollup": "^4.60.2",
    "texample": "^1.0.1"
  }
}
